<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThomasRobinSlidingBlockPuzzle.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Button
                Text="Shuffle Puzzle"
                Clicked="Shuffle"/>

            <Grid
                x:Name="PuzzleGrid"
                ColumnDefinitions="*, *, *"
                RowDefinitions="*, *, *"
                RowSpacing="2"
                ColumnSpacing="2">

                <Image
                    x:Name="TopLeft"
                    Grid.Row="0"
                    Grid.Column="0"
                    Aspect="AspectFit" >
                    <Image.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="ImageSliding" />
                    </Image.GestureRecognizers>
                </Image>

                <Image
                    x:Name="TopCentre"
                    Grid.Row="0"
                    Grid.Column="1"
                    Aspect="AspectFit" >
                    <Image.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="ImageSliding" />
                    </Image.GestureRecognizers>
                </Image>

                <Image
                    x:Name="TopRight"
                    Grid.Row="0"
                    Grid.Column="2"
                    Aspect="AspectFit" >
                    <Image.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="ImageSliding" />
                    </Image.GestureRecognizers>
                </Image>

                <Image
                    x:Name="MiddleLeft"
                    Grid.Row="1"
                    Grid.Column="0"
                    Aspect="AspectFit" >
                    <Image.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="ImageSliding" />
                    </Image.GestureRecognizers>
                </Image>

                <Image
                    x:Name="MiddleCentre"
                    Grid.Row="1"
                    Grid.Column="1"
                    Aspect="AspectFit" >
                    <Image.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="ImageSliding" />
                    </Image.GestureRecognizers>
                </Image>

                <Image
                    x:Name="MiddleRight"
                    Grid.Row="1"
                    Grid.Column="2"
                    Aspect="AspectFit" >
                    <Image.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="ImageSliding" />
                    </Image.GestureRecognizers>
                </Image>

                <Image
                    x:Name="BottomLeft"
                    Grid.Row="2"
                    Grid.Column="0"
                    Aspect="AspectFit" >
                    <Image.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="ImageSliding" />
                    </Image.GestureRecognizers>
                </Image>

                <Image
                    x:Name="BottomCentre"
                    Grid.Row="2"
                    Grid.Column="1"
                    Aspect="AspectFit" >
                    <Image.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="ImageSliding" />
                    </Image.GestureRecognizers>
                </Image>

                <Image
                    x:Name="BottomRight"
                    Grid.Row="2"
                    Grid.Column="2"
                    Aspect="AspectFit" >
                    <Image.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="ImageSliding" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
